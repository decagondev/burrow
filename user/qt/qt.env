# qt.env - the environment Qt programs need on Burrow (W15), one KEY=VALUE
# per line. It goes onto the Qt data disk (/opt/qt/qt.env); when that disk
# mounts, the kernel adds these to every program the console runs
# (kernel/cmd/kernel/disks.go). Qt finds its devices from these, not from
# udev, and its fonts without fontconfig. Docs: docs/04-plan/waves/WAVE-15-qt.md.
QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0
QT_QPA_EVDEV_KEYBOARD_PARAMETERS=/dev/input/event0:grab=1
QT_QPA_EVDEV_MOUSE_PARAMETERS=/dev/input/event1
QT_QPA_FONTDIR=/opt/qt/fonts
XDG_RUNTIME_DIR=/tmp
