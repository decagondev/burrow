# busybox.config - the busybox options Burrow builds (W10-S08), applied on
# top of `make allnoconfig` by scripts/busybox.sh. One CONFIG_ name per line,
# switched on; `KEY=value` lines set a value. Keep it to applets the kernel
# can serve: nothing here needs /proc or mount (networking since W17, users
# and the login tools since W19).
# Docs: docs/04-plan/waves/WAVE-10-a-unix.md (S08).

# the binary: static, applets found without links in /bin
STATIC
LFS
LONG_OPTS
SHOW_USAGE
FEATURE_VERBOSE_USAGE
BUSYBOX
FEATURE_SH_STANDALONE
FEATURE_PREFER_APPLETS
BUSYBOX_EXEC_PATH="/bin/busybox"

# the shell
SH_IS_ASH
ASH
ASH_OPTIMIZE_FOR_SIZE
ASH_BASH_COMPAT
ASH_JOB_CONTROL
ASH_ALIAS
ASH_ECHO
ASH_PRINTF
ASH_TEST
ASH_GETOPTS
ASH_CMDCMD
FEATURE_SH_MATH
FEATURE_EDITING
FEATURE_EDITING_HISTORY
FEATURE_TAB_COMPLETION

# the editor (W13-S01); not FEATURE_VI_ASK_TERMINAL: it asks the terminal
# where the cursor is (ESC[6n), and the screen console cannot answer yet
VI
FEATURE_VI_MAX_LEN=4096
FEATURE_VI_8BIT
FEATURE_VI_COLON
FEATURE_VI_COLON_EXPR
FEATURE_VI_YANKMARK
FEATURE_VI_SEARCH
FEATURE_VI_USE_SIGNALS
FEATURE_VI_DOT_CMD
FEATURE_VI_READONLY
FEATURE_VI_SETOPTS
FEATURE_VI_SET
FEATURE_VI_WIN_RESIZE
FEATURE_VI_UNDO
FEATURE_VI_UNDO_QUEUE
FEATURE_VI_UNDO_QUEUE_MAX=256
FEATURE_VI_VERBOSE_STATUS
FEATURE_ALLOW_EXEC

# applets
BASENAME
CAT
CLEAR
CP
CUT
DATE
DIRNAME
ECHO
FEATURE_FANCY_ECHO
ENV
EXPR
FALSE
FIND
FEATURE_FIND_NAME
FEATURE_FIND_TYPE
GREP
HEAD
FEATURE_FANCY_HEAD
HEXDUMP
HOSTNAME
ID
KILL
LN
LS
FEATURE_LS_FILETYPES
FEATURE_LS_FOLLOWLINKS
FEATURE_LS_SORTFILES
FEATURE_LS_TIMESTAMPS
MD5SUM
FEATURE_MD5_SHA1_SUM_CHECK
MKDIR
MV
OD
PRINTF
PWD
RESET
RM
RMDIR
SED
SEQ
SHA256SUM
SLEEP
SORT
FEATURE_SORT_BIG
STTY
TAIL
FEATURE_FANCY_TAIL
TEE
TEST
TEST1
TEST2
TOUCH
TR
TRUE
TTY
UNAME
UNIQ
WC
WHOAMI
XARGS
YES

# networking (W17-S04, S05): IPv6, the clients and the servers
FEATURE_IPV6
FEATURE_PREFER_IPV4_ADDRESS
VERBOSE_RESOLUTION_ERRORS
WGET
FEATURE_WGET_LONG_OPTIONS
FEATURE_WGET_TIMEOUT
PING
PING6
FEATURE_FANCY_PING
NSLOOKUP
NC
HTTPD
FEATURE_HTTPD_RANGES

# users (W19-S06): logging in, su, passwords and accounts; shadow passwords
# hashed with busybox's own SHA-512 crypt; busybox installed set-uid root,
# dropping root for every applet but the ones that need it (su, passwd)
LOGIN
SU
PASSWD
ADDUSER
DELUSER
ADDGROUP
DELGROUP
CRYPTPW
FEATURE_SHADOWPASSWDS
USE_BB_CRYPT
USE_BB_CRYPT_SHA
FEATURE_DEFAULT_PASSWD_ALGO="sha512"
FEATURE_SUID
FEATURE_ADDUSER_TO_GROUP
FEATURE_DEL_USER_FROM_GROUP
CHMOD
CHOWN
CHGRP
STAT
FEATURE_STAT_FORMAT
READLINK
FEATURE_READLINK_FOLLOW
# the id ranges adduser and addgroup pick from (allnoconfig leaves them 0)
LAST_ID=60000
FIRST_SYSTEM_ID=100
LAST_SYSTEM_ID=999
