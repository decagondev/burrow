# busybox.config - the busybox options Burrow builds (W10-S08), applied on
# top of `make allnoconfig` by scripts/busybox.sh. One CONFIG_ name per line,
# switched on; `KEY=value` lines set a value. Keep it to applets the kernel
# can serve: nothing here needs /proc, networking, mount or users.
# Docs: docs/04-plan/waves/WAVE-10-a-unix.md (S08).

# the binary: static, applets found without links in /bin
STATIC
LFS
LONG_OPTS
SHOW_USAGE
FEATURE_VERBOSE_USAGE
BUSYBOX
FEATURE_SH_STANDALONE
FEATURE_PREFER_APPLETS
BUSYBOX_EXEC_PATH="/bin/busybox"

# the shell
SH_IS_ASH
ASH
ASH_OPTIMIZE_FOR_SIZE
ASH_BASH_COMPAT
ASH_JOB_CONTROL
ASH_ALIAS
ASH_ECHO
ASH_PRINTF
ASH_TEST
ASH_GETOPTS
ASH_CMDCMD
FEATURE_SH_MATH
FEATURE_EDITING
FEATURE_EDITING_HISTORY
FEATURE_TAB_COMPLETION

# applets
BASENAME
CAT
CLEAR
CP
CUT
DATE
DIRNAME
ECHO
FEATURE_FANCY_ECHO
ENV
EXPR
FALSE
FIND
FEATURE_FIND_NAME
FEATURE_FIND_TYPE
GREP
HEAD
FEATURE_FANCY_HEAD
HEXDUMP
HOSTNAME
ID
KILL
LN
LS
FEATURE_LS_FILETYPES
FEATURE_LS_FOLLOWLINKS
FEATURE_LS_SORTFILES
MD5SUM
MKDIR
MV
OD
PRINTF
PWD
RESET
RM
RMDIR
SED
SEQ
SHA256SUM
SLEEP
SORT
FEATURE_SORT_BIG
STTY
TAIL
FEATURE_FANCY_TAIL
TEE
TEST
TEST1
TEST2
TOUCH
TR
TRUE
TTY
UNAME
UNIQ
WC
WHOAMI
XARGS
YES
