# x11.env - the environment X programs need on Burrow (W16), one KEY=VALUE
# per line, on the X data disk (/opt/x11/x11.env); like qt.env, it joins
# every program's environment when the disk mounts.
# Docs: docs/04-plan/waves/WAVE-16-x11-desktop.md.
DISPLAY=:0
FONTCONFIG_FILE=/opt/x11/etc/fonts/fonts.conf
