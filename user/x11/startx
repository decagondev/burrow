#!/bin/busybox sh
# startx for Burrow (W16-S06): starts Xfbdev on display :0 (its log in
# /tmp/x.log), waits for its socket, runs the first xinitrc it finds
# ($HOME/.xinitrc, /home/.xinitrc, then /opt/x11/etc/xinitrc, which starts
# dwm) and stops the server when that script ends, so the console comes
# back. Run it from busybox sh, or as `run /opt/x11/bin/startx` from the
# console. W25-S05: the ext2 root's set-user-id copy (/usr/bin/Xfbdev) when
# there is one, so a user can start X. Never touches the home disk itself.
# Docs: docs/06-guides/DESKTOP.md.
B=/bin/busybox
X=/opt/x11/bin/Xfbdev
[ -u /usr/bin/Xfbdev ] && X=/usr/bin/Xfbdev
$X :0 -nolock > /tmp/x.log 2>&1 &
server=$!
tries=0
while [ ! -S /tmp/.X11-unix/X0 ] && [ $tries -lt 30 ]; do
	$B sleep 1
	tries=$((tries + 1))
done
if [ ! -S /tmp/.X11-unix/X0 ]; then
	echo "startx: the server did not start; /tmp/x.log says:"
	$B tail -5 /tmp/x.log
	kill $server 2> /dev/null
	exit 1
fi
# W22-S05: no pointer acceleration, so a pointer moved by the tablet (its
# moves through /dev/input/mice) stays where the host's is.
/opt/x11/bin/xaccel
for rc in "$HOME/.xinitrc" /home/.xinitrc /opt/x11/etc/xinitrc; do
	[ -f "$rc" ] && break
done
echo "startx: $rc"
$B sh "$rc"
kill $server
wait $server
echo "startx: done"
