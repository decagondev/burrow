# The desktop (W16-S06), first boot: go-dev.img with a fresh home disk on
# hdb (workbench/, so /home/.xinitrc is the session) and the X disk on hdc.
# Waiters start before startx (xfocus waits for the server too) and say on
# the serial line when dwm, each st and dmenu are up; the terminals report
# on /dev/tty1. Two terminals, vi saves a file in the first, the second
# shows .xinitrc's /home, Doom from dmenu to its title and out through the
# menu, Alt+Shift+q, and startx hands the console back.
# W22-S06: with QEMU's tablet and an AC'97 that records: the pointer is put
# on the first terminal by absolute position and clicked, which gives it
# dwm's focus back from the second (only the first shell set ONE); Doom's menu
# sounds land in the WAV, which checkwav.py counts.
wait burrow>
screen 1024 768
type run /bin/busybox sh
key ret
wait built-in shell
type X=/opt/x11/bin/xfocus; for w in dwm st-256color '-n 2 st-256color' dmenu; do $X -w -t 300 $w & done; startx; echo desktop: console back
key ret
wait startx: /home/.xinitrc
wait xfocus: dwm
sleep 1
# TinyX spends its first packets finding the mouse's protocol: small moves,
# then the corner, which puts X's pointer in step (the kernel overshoots
# edges), then the left, where dwm will put the second terminal (a new
# window is the master), so that until the click the pointer is over it
abs 200 400
abs 210 410
abs 200 400
abs 210 410
abs 200 400
abs 210 410
abs 200 400
abs 210 410
sleep 1
abs 0 0
sleep 1
abs 200 400
sleep 1
key alt-shift-ret
wait xfocus: st-256color
sleep 1
type vi desk.txt
key ret
sleep 3
type i
type written with vi on the desktop
key esc
sleep 1
type :wq
key ret
sleep 2
type cat desk.txt > /dev/tty1; ONE=first
key ret
wait written with vi on the desktop
key alt-shift-ret
wait xfocus: st-256color #2
sleep 1
type echo desktop: two in $(pwd) > /dev/tty1
key ret
wait desktop: two in /home
abs 800 400
sleep 1
click left
sleep 1
type echo desktop: focus on ${ONE:-the second} > /dev/tty1
key ret
wait desktop: focus on first
key alt-p
wait xfocus: dmenu
sleep 1
type doom
key ret
wait doom: X window 640x400 at 192,184
waitpixel 251 561 #ff801c
waitpixel 832 584 #440101
screendump build/screen-desktop-doom.ppm
key esc
sleep 1
key up
sleep 1
key ret
sleep 1
type y
sleep 3
screendump build/screen-desktop.ppm
key alt-shift-q
wait startx: done
wait desktop: console back
sleep 2
screendump build/screen-desktop-back.ppm
type exit
key ret
wait burrow>
type poweroff
key ret
