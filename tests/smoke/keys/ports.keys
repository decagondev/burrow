# Ported and multi-threaded programs (W12), typed into the Go kernel's console.
wait burrow> 
type run /bin/threads
key ret
wait threads: ok
wait burrow> 
type run /bin/gohello
key ret
wait gohello: 
wait burrow> 
type run /bin/startup
key ret
wait startup: 
wait burrow> 
# W14-S05: mmap of files from /tmp (memfs), / (tarfs) and /mnt (FAT)
type run /bin/mmaptest /bin/sh /mnt/hello.txt
key ret
wait mmaptest: 
wait burrow> 
# W14-S06: socket pairs (the same binary passed on the host's Linux first)
type run /bin/socktest
key ret
wait socktest: 
wait burrow> 
# W14-S07: named sockets, connections and descriptor passing
type run /bin/socknames
key ret
wait socknames: 
wait burrow> 
# W16-S03: a pseudo-terminal as st uses one (passed on the host's Linux first)
type run /bin/ptytest
key ret
wait ptytest: 
wait burrow> 
# W17-S03: inet sockets over loopback (passed on the host's Linux first)
type run /bin/nettest
key ret
wait nettest: ok
wait burrow> 
# W18-S01: fork of a 64 MiB process, copy-on-write (passed on the host's Linux first)
type run /bin/forkbench
key ret
wait forkbench: ok
wait burrow> 
# W18-S03: shared memory (passed on the host's Linux first)
type run /bin/shmtest
key ret
wait shmtest: 
wait burrow> 
# W18-S05: a dynamic program, a shared library and dlopen (passed on the host's Linux first)
type run /bin/dynhello
key ret
wait dynhello: 
wait burrow> 
type poweroff
key ret
