# Ported and multi-threaded programs (W12), typed into the Go kernel's console.
wait burrow> 
type run /bin/threads
key ret
wait threads: ok
wait burrow> 
type run /bin/gohello
key ret
wait gohello: 
wait burrow> 
type run /bin/startup
key ret
wait startup: 
wait burrow> 
# W14-S05: mmap of files from /tmp (memfs), / (tarfs) and /mnt (FAT)
type run /bin/mmaptest /bin/sh /mnt/hello.txt
key ret
wait mmaptest: 
wait burrow> 
# W14-S06: socket pairs (the same binary passed on the host's Linux first)
type run /bin/socktest
key ret
wait socktest: 
wait burrow> 
# W14-S07: named sockets, connections and descriptor passing
type run /bin/socknames
key ret
wait socknames: 
wait burrow> 
# W16-S03: a pseudo-terminal as st uses one (passed on the host's Linux first)
type run /bin/ptytest
key ret
wait ptytest: 
wait burrow> 
# W17-S03: inet sockets over loopback (passed on the host's Linux first)
type run /bin/nettest
key ret
wait nettest: ok
wait burrow> 
# W18-S01: fork of a 64 MiB process, copy-on-write (passed on the host's Linux first)
type run /bin/forkbench
key ret
wait forkbench: ok
wait burrow> 
# W18-S03: shared memory (passed on the host's Linux first)
type run /bin/shmtest
key ret
wait shmtest: 
wait burrow> 
# W18-S05: a dynamic program, a shared library and dlopen (passed on the host's Linux first)
type run /bin/dynhello
key ret
wait dynhello: 
wait burrow> 
# W19-S03: users and groups (passed as root on the host's Linux first, with --exec)
type run /bin/credtest
key ret
wait credtest: ok
wait burrow> 
# W19-S04: credtest's set-id exec (chown works now), then owners and permissions in /tmp
type run /bin/credtest --exec /bin/credtest
key ret
wait credtest: ok
wait burrow> 
type run /bin/permtest /tmp/permtest
key ret
wait permtest: ok
wait burrow> 
# W19-S05: symbolic and hard links in /tmp (passed on the host's Linux first)
type run /bin/linktest /tmp/linktest
key ret
wait linktest: ok
wait burrow> 
# W20-S01: children ending in every way while their parent waits (BUG-0023's shape; passed on the host's Linux first)
type run /bin/waitstress 100
key ret
wait waitstress: 100 rounds ok
wait burrow> 
# BUG-0028: system() and posix_spawn (musl's clone onto a new stack)
type run /bin/spawntest
key ret
wait spawntest: ok
wait burrow> 
type poweroff
key ret
