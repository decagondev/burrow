# /proc (W23-S01): busybox's process tools on go-busybox.img: ps lists init
# and the shell, free and uptime read sysinfo and /proc, pidof finds a
# spinning program and pkill ends it. W23-S02: the spinning program's utime
# in /proc/<pid>/stat grows by most of 2 s of ticks, top lists it, time
# reports a second of real time. W23-S03: tty names the console (musl's
# ttyname over /proc/self/fd), ls -l shows the links, df sizes /tmp and /,
# mount lists /proc. W23-S06: syslogd on /dev/log (a named datagram
# socket) writes logger's line to a file, then to its circular buffer
# (SysV shared memory and semaphores), where logread finds it.
# Expect file: tests/smoke/expect/proc.txt.
wait burrow>
type run /bin/busybox sh
key ret
wait #
type ps
key ret
wait COMMAND
type free
key ret
wait Mem:
type uptime
key ret
wait load average:
type cat /proc/self/comm /proc/version
key ret
wait Burrow version
type /bin/spin > /dev/null &
key ret
sleep 1
type pidof spin > /dev/null && echo found spin'ning'
key ret
wait found spinning
type p=$(pidof spin); a=$(cut -d' ' -f14 /proc/$p/stat); sleep 2; b=$(cut -d' ' -f14 /proc/$p/stat); [ $((b-a)) -ge 150 ] && echo spin comp''uted for 2 s
key ret
wait computed for 2 s
type top -b -n 1 | grep '[/]bin/spin'
key ret
type time sleep 1
key ret
wait sys
type tty; ls -l /proc/self/fd | grep -c /dev/tty1
key ret
type df /tmp /; mount | grep proc
key ret
wait type proc
type syslogd -O /tmp/messages; logger -t smoke first'' message; sleep 1; grep -c 'smoke: first message' /tmp/messages
key ret
type killall syslogd; sleep 1; syslogd -C16; logger -t smoke second'' message; sleep 1; logread | grep -o 'smoke: second message'
key ret
wait smoke: second message
type killall syslogd
key ret
type pkill spin; sleep 1; pidof spin || echo spin'ning' gone
key ret
wait spinning gone
type ps | grep -c 'busybox sh'
key ret
type exit
key ret
wait burrow>
type poweroff
key ret
