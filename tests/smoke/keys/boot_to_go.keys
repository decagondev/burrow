# Typed into the Go kernel's console over the PS/2 keyboard (W7-S05), after
# the console is up. A typo corrected with backspace, then a clean exit.
wait burrow> 
screendump build/screen-boot_to_go.ppm
type echo hello from the keyboarx
key backspace
type d
key ret
type lspci
key ret
type cat /etc/motd
key ret
type write /tmp/note typed into ramfs
key ret
type cat /tmp/note
key ret
type ls /
key ret
type ls /dev
key ret
type write /dev/console written to the console device
key ret
type disks
key ret
screendump build/screen-boot_to_go-end.ppm
type poweroff
key ret
