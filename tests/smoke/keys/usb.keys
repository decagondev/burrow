# Typed into the Go console of go-uefi.img on q35 under OVMF with no PS/2
# controller (make usb-smoke, W27-S03): QEMU's sendkey reaches the USB
# keyboard on the xHCI controller, its mouse_move the USB mouse. A typo
# corrected, Ctrl-C, shifted characters in sh, then mousetest and paint as
# desk.keys drives them, then poweroff.
wait burrow>
type echo hello from the usb keyboarx
key backspace
type d
key ret
type irqs
key ret
type cat /mnt/hello.txt
key ret
type run /bin/spin
key ret
wait spin: spinning
key ctrl-c
type sh
key ret
wait $
type echo SHI''FT "Q|W" ~!
key ret
wait SHIFT Q|W ~!
type exit
key ret
wait burrow>
type run /bin/mousetest
key ret
wait right click ends
mouse 100 50
click left
wait left down at
click right
wait mousetest: done
wait burrow>
# paint: the cursor starts at the screen's centre (512,384 at 1024x768): up
# to the red swatch (96,32) and click; down to (96,332), then drag right to
# (496,332).
type run /bin/paint
key ret
wait paint: ready
mouse -416 -352
click left
mouse 0 300
press left
mouse 200 0
mouse 200 0
release left
sleep 1
screendump build/screen-usb-paint.ppm
key esc
wait paint: 1 strokes, last colour ff0000
wait burrow>
type poweroff
key ret
