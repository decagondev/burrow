# Qt on Burrow (W15), typed into the Go kernel's console on go.img with the
# Qt data disk (qt-data.img, mounted at /opt/qt). S02: QtCore from a FAT
# mount: threads, timers, files, QProcess.
wait burrow>
type run /opt/qt/bin/qthello
key ret
wait qthello:
wait burrow>
# S03: qtwindow through linuxfb on /dev/fb0, DejaVu text from /opt/qt/fonts;
# the console must come back when it quits.
type run /opt/qt/bin/qtwindow --quit-after 4000
key ret
wait qtwindow: shown
sleep 1
screendump build/screen-qt-window.ppm
wait burrow>
sleep 1
screendump build/screen-qt-after.ppm
# killed with the screen taken (SIGABRT): the kernel gives the console back
type run /opt/qt/bin/qtwindow --crash-after 3000
key ret
wait qtwindow: aborting
wait burrow>
sleep 1
screendump build/screen-qt-crash.ppm
# S04: qtdemo's widgets by keyboard and mouse. Type into the line edit
# (it has the focus); send the mouse to the corner (Qt clamps it at 0,0,
# wherever its cursor started), then to the Add button (529,125: qtdemo's
# ready line says where) and click
# (sendkeys.py splits long moves so QEMU's PS/2 queue takes them);
# type a second line and press Enter; open the File menu (21,12), close it
# with Esc; quit with Ctrl+Q.
type run /opt/qt/bin/qtdemo
key ret
wait qtdemo: ready
type hello burrow
wait typed "hello burrow"
mouse -2000 -2000
sleep 1
mouse 529 125
sleep 1
click left
wait added "hello burrow"
type second
key ret
wait added "second"
mouse -508 -113
sleep 1
click left
wait menu open
sleep 1
screendump build/screen-qt-demo.ppm
key esc
wait menu closed
key ctrl-q
wait qtdemo: quit
wait burrow>
type poweroff
key ret
