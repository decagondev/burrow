# The device files programs use (W11), typed into the Go kernel's console:
# fbtest paints colour bars through /dev/fb0 and keeps it open while the
# screen is dumped; Enter lets it go and the console repaints.
wait burrow>
type run /bin/fbtest
key ret
wait fbtest: bars drawn
screendump build/screen-devices-fb0.ppm
key ret
wait fbtest: done
wait burrow>
screendump build/screen-devices-after.ppm
# evtest owns the keyboard while it runs: a, b, the up arrow, then q quits
type run /bin/evtest
key ret
wait evtest: device
type ab
key up
type q
wait evtest: done
wait burrow> 
# mousetest (W14-S02): the cursor starts in the middle, moves right 100 and
# down 50, a left click reports where, the screen is dumped, a right click ends
type run /bin/mousetest
key ret
wait mousetest: reading
mouse 100 50
sleep 0.5
click left
wait mousetest: left down
screendump build/screen-devices-mouse.ppm
click right
wait mousetest: done
wait burrow> 
type poweroff
key ret
