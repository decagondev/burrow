# Pixels of the X desktop on Burrow (W16), dumped by tests/smoke/keys/x11.keys.
# Append-only.
# S02: Xfbdev on /dev/fb0 with xhello (user/x11/xhello.c) mapped at (20,20):
# its three rectangles, its background, the Xft text, and X's own root weave
# (the server's default background) outside the window.
size  build/screen-x11-xhello.ppm 1024 768
pixel build/screen-x11-xhello.ppm 140 120 #e03030
pixel build/screen-x11-xhello.ppm 340 120 #30c050
pixel build/screen-x11-xhello.ppm 540 120 #3060e0
pixel build/screen-x11-xhello.ppm 40 380 #202430
pixel build/screen-x11-xhello.ppm 100 280 #ffffff
pixel build/screen-x11-xhello.ppm 800 600 #000000
pixel build/screen-x11-xhello.ppm 801 601 #ffffff
# after the server exits: the console is back (the band and the paper)
size  build/screen-x11-after.ppm 1024 768
pixel build/screen-x11-after.ppm 10 40 #007d9c
pixel build/screen-x11-after.ppm 500 500 #1e1e28
# S03: st (fonts through Xft) running busybox sh after the typed line: its
# black background, the "#" of the last prompt in st's foreground #e5e5e5,
# the focused cursor (a solid block in #cccccc), the root weave beside it
size  build/screen-x11-st.ppm 1024 768
pixel build/screen-x11-st.ppm 400 300 #000000
pixel build/screen-x11-st.ppm 3 165 #e5e5e5
pixel build/screen-x11-st.ppm 27 163 #cccccc
pixel build/screen-x11-st.ppm 900 600 #000000
pixel build/screen-x11-st.ppm 901 601 #ffffff
# S04: dwm with two terminals tiled, the second (focused) as master: the bar
# (tag 1 and the title in dwm's cyan #005577, tag 3 in its grey #222222),
# the master's focused border (cyan) and the other terminal's (#444444),
# and the root weave in the gap between them
size  build/screen-x11-dwm.ppm 1024 768
pixel build/screen-x11-dwm.ppm 20 3 #005577
pixel build/screen-x11-dwm.ppm 600 3 #005577
pixel build/screen-x11-dwm.ppm 66 3 #222222
pixel build/screen-x11-dwm.ppm 555 600 #005577
pixel build/screen-x11-dwm.ppm 563 600 #444444
pixel build/screen-x11-dwm.ppm 300 600 #000000
# tag 2: selected in the bar, and nothing on it but the root weave
size  build/screen-x11-dwm-tag2.ppm 1024 768
pixel build/screen-x11-dwm-tag2.ppm 36 3 #005577
pixel build/screen-x11-dwm-tag2.ppm 20 3 #222222
pixel build/screen-x11-dwm-tag2.ppm 600 3 #222222
pixel build/screen-x11-dwm-tag2.ppm 600 400 #000000
pixel build/screen-x11-dwm-tag2.ppm 601 401 #ffffff
# S05: Doom started from dmenu floats at its fixed 640x400 at (192,184),
# where the fbdev Doom draws, inside dwm's focused border (cyan), so
# doom.screen's pixels sit one right and one down. Its title, then E1M1's
# status bar; after Quit Game the terminals are back, the focus on the one
# it was on before (Alt+j, S04).
size  build/screen-x11-doom-title.ppm 1024 768
pixel build/screen-x11-doom-title.ppm 192 184 #005577
pixel build/screen-x11-doom-title.ppm 833 585 #005577
pixel build/screen-x11-doom-title.ppm 193 185 #8b0101
pixel build/screen-x11-doom-title.ppm 251 561 #ff801c
pixel build/screen-x11-doom-title.ppm 832 584 #440101
pixel build/screen-x11-doom-title.ppm 190 300 #000000
size  build/screen-x11-doom-e1m1.ppm 1024 768
pixel build/screen-x11-doom-e1m1.ppm 192 184 #005577
pixel build/screen-x11-doom-e1m1.ppm 197 526 #1c1c1c
pixel build/screen-x11-doom-e1m1.ppm 251 541 #303030
pixel build/screen-x11-doom-e1m1.ppm 781 536 #9f9f9f
pixel build/screen-x11-doom-e1m1.ppm 241 576 #8b8b8b
size  build/screen-x11-doom-gone.ppm 1024 768
pixel build/screen-x11-doom-gone.ppm 192 184 #000000
pixel build/screen-x11-doom-gone.ppm 241 576 #000000
pixel build/screen-x11-doom-gone.ppm 563 600 #005577
